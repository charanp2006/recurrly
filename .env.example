# Environment Configuration Example
# Copy this to .env.local and fill in the values

# API Configuration
# Use your machine's LAN IP for physical Android/iOS devices.
# Android emulator can use: http://10.0.2.2:5500/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.12:5500/api/v1

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Cloudinary (for image uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_preset
